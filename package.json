{
  "name": "time-off-app",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "android:sync": "corepack pnpm run build && cap sync android",
    "android:open": "cap open android",
    "build:android": "corepack pnpm run android:sync && node scripts/build-android.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "preview": "vite preview",
    "lint": "corepack pnpm run eslint && corepack pnpm run typecheck:e2e && corepack pnpm run prettier --check && corepack pnpm run style:check",
    "lint:fix": "corepack pnpm run eslint --fix && corepack pnpm run prettier --write",
    "eslint": "eslint --max-warnings 0",
    "prettier": "prettier \"**/*.{ts,tsx}\"",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json",
    "test": "corepack pnpm run test:unit && corepack pnpm run test:e2e",
    "test:unit": "vitest run && node --test scripts/check-code-style.test.mjs",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "style:check": "node scripts/check-code-style.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/core": "8.6.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@ionic/react": "^9.0.0",
    "@ionic/react-router": "^9.0.0",
    "ionicons": "^8.1.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-router": "^6.30.0",
    "react-router-dom": "^6.30.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@ionic/eslint-config": "^0.5.0",
    "@ionic/prettier-config": "^4.0.0",
    "@playwright/test": "^1.64.1",
    "@storybook/react-vite": "^10.6.6",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "@vitejs/plugin-legacy": "^8.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "sass": "^1.108.1",
    "storybook": "^10.6.6",
    "terser": "^5.16.0",
    "typescript": "~5.9.0",
    "vite": "^8.0.0",
    "vitest": "^5.1.0"
  },
  "prettier": "@ionic/prettier-config",
  "description": "An Ionic project"
}
